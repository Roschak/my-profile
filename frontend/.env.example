# ============================================================
# .env.example — Template for environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ============================================================

# ── Backend API ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://your-backend.vercel.app

# ── Supabase (public) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key

# ── Supabase service role (SERVER ONLY — never expose) ───────
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── NextAuth ─────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── Admin Identity (SERVER ONLY — never add NEXT_PUBLIC_ prefix) ─
# ADMIN_EMAIL: only this Google account can access /admin
# ADMIN_GOOGLE_ID: optional second factor (Google sub ID)
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_GOOGLE_ID=
